---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import site from '../data/site.json';
import { SERVICES, LIMITS } from '../lib/contact-rules';

// Cloudflare's public test key (always passes) is used until the real key is set.
// The server rejects test tokens once a real secret key is configured, so this fails safe.
const TEST_SITE_KEY = '1x00000000000000000000AA';
const siteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY || TEST_SITE_KEY;
if (siteKey === TEST_SITE_KEY) console.warn('[contact] PUBLIC_TURNSTILE_SITE_KEY is not set; using the Turnstile test key.');
---
<Base
  title="Contact"
  description="Book a free 15-minute consult with Caylor Made Technologies. Websites and custom software for businesses in Hereford, TX and the Texas Panhandle."
>
  <script is:inline slot="head" src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>

  <PageHero
    eyebrow="Contact"
    title="Let’s talk about your project"
    lead="Tell me a little about your business and what you need. I’ll reply within one business day to set up your free 15-minute consult."
  />

  <section class="section">
    <div class="container contact">
      <div class="card contact__form-card">
        <div id="form-success" class="notice notice--success" role="status" tabindex="-1" hidden>
          <Icon name="check" />
          <div>
            <h2>Message sent. Thanks!</h2>
            <p>I’ll get back to you within one business day. If it’s urgent, call or text <a href={`tel:${site.phoneE164}`}>{site.phone}</a>.</p>
          </div>
        </div>

        <form id="contact-form" action="/api/contact" method="post" novalidate data-sitekey={siteKey}>
          <h2 class="form-title">Send a message</h2>
          <p class="muted form-note">Fields marked <span aria-hidden="true">*</span><span class="visually-hidden">with an asterisk</span> are required.</p>

          <div id="form-error" class="notice notice--error" role="alert" tabindex="-1" hidden></div>

          <div class="fields">
            <div class="field">
              <label for="name">Name <span aria-hidden="true">*</span></label>
              <input id="name" name="name" type="text" autocomplete="name" required maxlength={LIMITS.name} aria-describedby="name-error" />
              <p class="field__error" id="name-error"></p>
            </div>

            <div class="field">
              <label for="email">Email <span aria-hidden="true">*</span></label>
              <input id="email" name="email" type="email" autocomplete="email" inputmode="email" required maxlength={LIMITS.email} aria-describedby="email-error" />
              <p class="field__error" id="email-error"></p>
            </div>

            <div class="field">
              <label for="phone">Phone <span class="optional">(optional)</span></label>
              <input id="phone" name="phone" type="tel" autocomplete="tel" inputmode="tel" maxlength={LIMITS.phone} aria-describedby="phone-error" />
              <p class="field__error" id="phone-error"></p>
            </div>

            <div class="field">
              <label for="business">Business name <span class="optional">(optional)</span></label>
              <input id="business" name="business" type="text" autocomplete="organization" maxlength={LIMITS.business} aria-describedby="business-error" />
              <p class="field__error" id="business-error"></p>
            </div>

            <div class="field field--full">
              <label for="service">What do you need? <span aria-hidden="true">*</span></label>
              <select id="service" name="service" required aria-describedby="service-error">
                <option value="">Choose one…</option>
                {Object.entries(SERVICES).map(([value, label]) => <option value={value}>{label}</option>)}
              </select>
              <p class="field__error" id="service-error"></p>
            </div>

            <div class="field field--full">
              <label for="message">Message <span aria-hidden="true">*</span></label>
              <textarea id="message" name="message" rows="6" required minlength={LIMITS.messageMin} maxlength={LIMITS.message} aria-describedby="message-hint message-error"></textarea>
              <p class="field__hint muted" id="message-hint">What does your business do, and what would you like built?</p>
              <p class="field__error" id="message-error"></p>
            </div>

            <!-- Spam trap: hidden from people, filled in by bots. -->
            <div class="hp" aria-hidden="true">
              <label for="company_website">Leave this field empty</label>
              <input id="company_website" name="company_website" type="text" tabindex="-1" autocomplete="off" />
            </div>
          </div>

          <div class="turnstile">
            <div class="cf-turnstile" data-sitekey={siteKey} data-theme="dark" data-size="flexible" data-response-field-name="cf-turnstile-response"></div>
          </div>

          <button class="btn btn--primary btn--block submit" type="submit">
            <span class="submit__label">Send Message</span>
          </button>

          <noscript>
            <p class="notice notice--error">This form needs JavaScript for its spam check. You can email me at <a href={`mailto:${site.email}`}>{site.email}</a> instead.</p>
          </noscript>

          <p class="muted privacy-note">I only use your info to reply to you. See the <a href="/privacy/">Privacy Policy</a>.</p>
        </form>
      </div>

      <aside class="contact__info" aria-labelledby="info-title">
        <h2 id="info-title">Other ways to reach me</h2>
        <ul role="list" class="info-list">
          <li>
            <span class="icon-badge"><Icon name="mail" /></span>
            <div><p class="label">Email</p><a href={`mailto:${site.email}`}>{site.email}</a></div>
          </li>
          <li>
            <span class="icon-badge"><Icon name="phone" /></span>
            <div><p class="label">Call or text</p><a href={`tel:${site.phoneE164}`}>{site.phone}</a></div>
          </li>
          <li>
            <span class="icon-badge"><Icon name="pin" /></span>
            <div><p class="label">Service area</p><p>{site.serviceAreaText}</p></div>
          </li>
          <li>
            <span class="icon-badge"><Icon name="clock" /></span>
            <div><p class="label">Response time</p><p>Within one business day</p></div>
          </li>
        </ul>
      </aside>
    </div>
  </section>
</Base>

<script>
  import '../scripts/contact';
</script>

<style>
  .contact {
    display: grid;
    gap: clamp(2rem, 5vw, 3rem);
    align-items: start;
  }
  @media (min-width: 60rem) {
    .contact { grid-template-columns: 1.6fr 1fr; }
  }
  .contact__form-card { padding: clamp(1.25rem, 4vw, 2.25rem); }
  .form-title { font-size: var(--step-2); }
  .form-note { margin-top: 0.25rem; font-size: 0.9rem; }

  .fields {
    display: grid;
    gap: 1.1rem 1rem;
    margin-top: 1.5rem;
  }
  @media (min-width: 40rem) {
    .fields { grid-template-columns: 1fr 1fr; }
    .field--full { grid-column: 1 / -1; }
  }
  .field { display: grid; gap: 0.4rem; }
  label { font-weight: 600; color: var(--text-heading); font-size: 0.95rem; }
  label span[aria-hidden] { color: var(--blue-glow); }
  .optional { color: var(--text-muted); font-weight: 400; }
  input, select, textarea {
    width: 100%;
    min-height: 48px;
    padding: 0.7rem 0.9rem;
    border-radius: 10px;
    border: 1px solid rgba(138, 151, 168, 0.45);
    background: var(--bg);
    color: var(--text-heading);
    font-size: 1rem; /* 16px+ stops iPhone zooming in on focus */
    transition: border-color 0.2s, box-shadow 0.2s;
  }
  textarea { resize: vertical; min-height: 9rem; line-height: 1.5; }
  select { appearance: none; background-image: linear-gradient(45deg, transparent 50%, var(--blue-glow) 50%), linear-gradient(135deg, var(--blue-glow) 50%, transparent 50%); background-position: calc(100% - 20px) 50%, calc(100% - 14px) 50%; background-size: 6px 6px; background-repeat: no-repeat; padding-right: 2.5rem; }
  input:hover, select:hover, textarea:hover { border-color: var(--border-strong); }
  input:focus-visible, select:focus-visible, textarea:focus-visible {
    outline: none;
    border-color: var(--blue-glow);
    box-shadow: 0 0 0 3px rgba(61, 139, 255, 0.35);
  }
  [aria-invalid='true'] { border-color: var(--error); }
  .field__error { color: var(--error); font-size: 0.9rem; min-height: 0; }
  .field__error:empty { display: none; }
  .field__hint { font-size: 0.875rem; }

  .hp { position: absolute; left: -10000px; width: 1px; height: 1px; overflow: hidden; }

  .turnstile { margin-block: 1.5rem 1rem; min-height: 65px; }
  .submit[disabled] { opacity: 0.7; cursor: progress; transform: none; }
  .privacy-note { margin-top: 1rem; font-size: 0.875rem; text-align: center; }

  .notice {
    display: flex;
    gap: 0.75rem;
    align-items: flex-start;
    padding: 1rem 1.1rem;
    border-radius: 10px;
    margin-top: 1rem;
  }
  .notice[hidden] { display: none; }
  .notice :global(svg) { flex: none; width: 24px; height: 24px; }
  .notice--success { border: 1px solid rgba(61, 220, 151, 0.5); background: rgba(61, 220, 151, 0.08); color: var(--text-heading); margin-top: 0; }
  .notice--success :global(svg) { color: var(--success); }
  .notice--success h2 { font-size: var(--step-1); margin-bottom: 0.25rem; }
  .notice--error { border: 1px solid rgba(255, 138, 138, 0.5); background: rgba(255, 138, 138, 0.08); color: var(--text-heading); display: block; }

  .contact__info h2 { font-size: var(--step-1); margin-bottom: 1.25rem; }
  .info-list { display: grid; gap: 1.25rem; }
  .info-list li { display: flex; gap: 1rem; align-items: flex-start; }
  .info-list .icon-badge { margin: 0; flex: none; }
  .label { font-size: 0.8rem; letter-spacing: 0.18em; text-transform: uppercase; color: var(--text-muted); font-weight: 600; }
  .info-list a { overflow-wrap: anywhere; font-weight: 500; }
</style>
