---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import CtaBand from '../components/CtaBand.astro';
import Icon from '../components/Icon.astro';
import shot from '../assets/projects/money-leak-finder.jpg';
import appIcon from '../assets/projects/money-leak-finder-icon.png';

const appUrl = 'https://money-leak-finder.andycaylor.workers.dev/';

// Flip to true once screenshot reading is switched on in the app.
const readerLive = false;

const features = [
  { icon: 'drop', title: 'Finds the leaks', text: 'Flags forgotten subscriptions, possible double charges, small buys that add up (fast food, gas station snacks, coffee), categories that jumped since last month, and fees. Each one shows what it costs this month and about how much per year.' },
  { icon: 'wrench', title: 'Plug it', text: 'Tap “Plug it” on a leak you’re going to fix. The savings flow straight into your goals so you can see the difference.' },
  { icon: 'target', title: 'Goals with a real plan', text: 'Emergency fund, a truck, a house down payment: see how much to save per week and per month, how long it takes now, and how much sooner it goes with the leaks plugged.' },
  { icon: 'chat', title: 'Plain-English tips', text: 'A short money story each month, like “Cutting eating out in half frees up $150 a month, which gets your goal done 4 months sooner.”' },
  { icon: 'clock', title: 'Coming up', text: 'Spots your recurring bills and subscriptions and shows what’s due in the next two weeks, so nothing sneaks up on you.' },
  { icon: 'trend', title: 'What investing could do', text: 'See what investing your leftover money each month could grow to over 5, 10, 20 and 30 years at a few example rates. Educational only, not financial advice.' },
  { icon: 'gears', title: 'Sorts itself', text: 'Every purchase lands in a category automatically. Fix one and it remembers that store from then on.' },
  readerLive
    ? { icon: 'camera', title: 'Snap a screenshot', text: 'Take a screenshot of a pay stub, your bank app’s list, or a receipt. It reads the dates and amounts and lets you check them before saving. The picture is never saved.' }
    : { icon: 'camera', title: 'Type it or upload a CSV', text: 'Add a paycheck or purchase in seconds, or upload the spreadsheet (CSV) your bank lets you download. Reading screenshots of pay stubs and receipts is coming soon.' },
  { icon: 'shield', title: 'Private by design', text: 'No bank logins, ever. Card and account numbers are hidden automatically, backups can be locked with a password, and an eye button hides your amounts in public.' },
];

const steps = [
  { title: 'iPhone', text: 'Open the app in Safari, tap the Share button, then “Add to Home Screen”.' },
  { title: 'Android', text: 'Open the app in Chrome, tap the ⋮ menu, then “Install app” or “Add to Home screen”.' },
  { title: 'Try it first', text: 'Tap “Try it with sample data” to look around before adding your own. Remove the sample any time in Settings.' },
];
---
<Base
  title="Money Leak Finder"
  description="Money Leak Finder is a free budgeting app by Caylor Made Technologies. It finds where your money slips away, plans your goals, and keeps your data on your phone."
>
  <PageHero
    eyebrow="Free app"
    title="Money Leak Finder"
    lead="Find where your money slips away. Spot forgotten subscriptions, fees and small buys that add up, then see how much faster your goals go when you plug them. Free and private."
  >
    <Image class="app-icon" src={appIcon} alt="" width={112} height={112} loading="eager" />
    <div class="btn-row hero-ctas">
      <a class="btn btn--primary" href={appUrl} target="_blank" rel="noopener noreferrer">
        Open Money Leak Finder <Icon name="external" /><span class="visually-hidden"> (opens in a new tab)</span>
      </a>
      <a class="btn btn--ghost" href="#install">How to install</a>
    </div>
  </PageHero>

  <section class="section" aria-labelledby="shots-title">
    <div class="container">
      <h2 id="shots-title" class="visually-hidden">Screenshots</h2>
      <div class="shot reveal">
        <Image src={shot} alt="Three Money Leak Finder phone screens: a monthly dashboard with $498 left over and 7 leaks found, the leak finder showing about $5,295 a year slipping away with a Plug it button, and a truck savings goal that gets done 2.2 months sooner with leaks plugged" widths={[480, 800, 1200, 1600]} sizes="(min-width: 72rem) 70rem, 94vw" format="webp" />
      </div>
    </div>
  </section>

  <section class="section section--alt" aria-labelledby="features-title">
    <div class="container">
      <div class="section-head section-head--center">
        <p class="eyebrow">What it does</p>
        <h2 id="features-title">Like a friend who’s good with money</h2>
      </div>
      <ul class="grid features" role="list">
        {features.map((f) => (
          <li class="card reveal">
            <span class="feature-icon"><Icon name={f.icon} /></span>
            <h3>{f.title}</h3>
            <p>{f.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section" id="install" aria-labelledby="install-title">
    <div class="container container--narrow">
      <div class="section-head section-head--center">
        <p class="eyebrow">Install</p>
        <h2 id="install-title">Put it on your home screen</h2>
        <p class="muted">No app store needed. It installs right from the browser.</p>
      </div>
      <ol class="steps" role="list">
        {steps.map((s, i) => (
          <li class="card reveal">
            <span class="step-num" aria-hidden="true">{i + 1}</span>
            <div><h3>{s.title}</h3><p>{s.text}</p></div>
          </li>
        ))}
      </ol>
      <div class="btn-row center">
        <a class="btn btn--primary" href={appUrl} target="_blank" rel="noopener noreferrer">
          Open Money Leak Finder <Icon name="external" /><span class="visually-hidden"> (opens in a new tab)</span>
        </a>
      </div>
    </div>
  </section>

  <section class="section section--alt" aria-labelledby="privacy-title">
    <div class="container container--narrow stack">
      <p class="eyebrow">Privacy</p>
      <h2 id="privacy-title">Your money data stays on your phone</h2>
      <p>No account, no bank login, no ads, no tracking. Your transactions, goals and settings are saved only on your phone, and you can back them up, export them, or delete everything any time in the app. It never asks for full account, card or routing numbers, and hides them automatically if one slips in.</p>
      {readerLive && <p>If you use screenshot reading, the picture is shrunk and stripped of location data on your phone, sent over an encrypted connection to be read once, and never saved. You agree to that first with a checkbox.</p>}
      <p class="muted">Money Leak Finder is an educational budgeting tool, not financial, tax or investment advice. Leak savings and investment numbers are estimates and examples, not promises.</p>
    </div>
  </section>

  <CtaBand title="Want an app like this for your business?" text="I build custom tools that solve real problems, like this one. Book a free 15-minute call and tell me what you need." />
</Base>

<style>
  :global(.page-hero) .app-icon {
    display: block;
    margin: 1.5rem auto 0;
    border-radius: 26px;
    box-shadow: 0 0 0 1px var(--border-strong), 0 0 40px rgba(61, 139, 255, 0.35);
  }
  .hero-ctas { justify-content: center; margin-top: 1.5rem; }
  .hero-ctas :global(svg), .center :global(svg) { width: 18px; height: 18px; }
  .shot img, .shot :global(img) {
    width: 100%;
    height: auto;
    border-radius: calc(var(--radius) + 4px);
    border: 1px solid var(--border-strong);
    box-shadow: var(--glow-md);
  }
  .features { --min: 17rem; list-style: none; padding: 0; }
  .feature-icon {
    display: inline-grid;
    place-items: center;
    width: 44px;
    height: 44px;
    margin-bottom: 0.75rem;
    border-radius: 12px;
    color: var(--blue-glow);
    background: rgba(30, 111, 255, 0.12);
    box-shadow: inset 0 0 0 1px var(--border-strong);
  }
  .feature-icon :global(svg) { width: 22px; height: 22px; }
  .steps { display: grid; gap: 1rem; list-style: none; padding: 0; margin-bottom: 2rem; }
  .steps li { display: flex; gap: 1rem; align-items: flex-start; }
  .step-num {
    flex: none;
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    font-weight: 700;
    color: #fff;
    background: var(--blue-button);
    box-shadow: 0 0 18px rgba(61, 139, 255, 0.4);
  }
  .center { justify-content: center; }
</style>
