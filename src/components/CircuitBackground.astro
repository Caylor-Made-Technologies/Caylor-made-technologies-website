---
// Decorative circuit-trace background, generated at build time (no runtime JS).
// Pulses travel along a few traces with CSS; they stop for prefers-reduced-motion.
interface Props { seed?: number; density?: number; class?: string }
const { seed = 7, density = 26, class: className } = Astro.props;

const W = 1200, H = 800;
let s = seed;
const rand = () => ((s = (s * 16807) % 2147483647) / 2147483647);
const pick = (min: number, max: number) => min + rand() * (max - min);
const snap = (n: number) => Math.round(n / 8) * 8;

type Trace = { d: string; end: [number, number]; pulse: boolean };
const traces: Trace[] = [];
for (let i = 0; i < density; i++) {
  const fromLeft = i % 2 === 0;
  const dir = fromLeft ? 1 : -1;
  const y0 = snap(pick(40, H - 40));
  const x0 = fromLeft ? -10 : W + 10;
  const run1 = snap(pick(60, 260));
  const diag = snap(pick(24, 90)) * (rand() > 0.5 ? 1 : -1);
  const run2 = snap(pick(40, 200));
  const x1 = x0 + dir * run1;
  const x2 = x1 + dir * Math.abs(diag);
  const y2 = y0 + diag;
  const x3 = x2 + dir * run2;
  traces.push({
    d: `M${x0} ${y0} H${x1} L${x2} ${y2} H${x3}`,
    end: [x3, y2],
    pulse: i % 3 === 0,
  });
}
// A few vertical traces from the top and bottom edges
for (let i = 0; i < Math.round(density / 4); i++) {
  const fromTop = i % 2 === 0;
  const dir = fromTop ? 1 : -1;
  const x0 = snap(i < 2 ? pick(80, 380) : pick(820, 1120));
  const y0 = fromTop ? -10 : H + 10;
  const run1 = snap(pick(60, 160));
  const diag = snap(pick(24, 64)) * (x0 < W / 2 ? 1 : -1);
  const y1 = y0 + dir * run1;
  const y2 = y1 + dir * Math.abs(diag);
  const x2 = x0 + diag;
  const y3 = y2 + dir * snap(pick(30, 110));
  traces.push({ d: `M${x0} ${y0} V${y1} L${x2} ${y2} V${y3}`, end: [x2, y3], pulse: i % 2 === 0 });
}
const maskId = `cmask-${seed}`;
const gradId = `cgrad-${seed}`;
---
<svg class:list={['circuit', className]} viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false">
  <defs>
    <radialGradient id={gradId} cx="50%" cy="45%" r="62%">
      <stop offset="0%" stop-color="#000" />
      <stop offset="38%" stop-color="#000" />
      <stop offset="100%" stop-color="#fff" />
    </radialGradient>
    <mask id={maskId}>
      <rect width={W} height={H} fill={`url(#${gradId})`} />
    </mask>
  </defs>
  <g mask={`url(#${maskId})`}>
    <g class="circuit__lines">
      {traces.map((t) => <path d={t.d} />)}
    </g>
    <g class="circuit__nodes">
      {traces.map((t) => <circle cx={t.end[0]} cy={t.end[1]} r="4.5" />)}
    </g>
    <g class="circuit__pulses">
      {traces.filter((t) => t.pulse).map((t) => <path d={t.d} pathLength="1000" />)}
    </g>
  </g>
</svg>

<style>
  .circuit {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
  .circuit__lines path {
    fill: none;
    stroke: rgba(61, 139, 255, 0.22);
    stroke-width: 1.5;
  }
  .circuit__nodes circle {
    fill: var(--bg);
    stroke: rgba(61, 139, 255, 0.45);
    stroke-width: 1.5;
  }
  .circuit__pulses path {
    fill: none;
    stroke: var(--blue-glow);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-dasharray: 60 1000;
    stroke-dashoffset: 60;
    opacity: 0;
    filter: drop-shadow(0 0 4px rgba(61, 139, 255, 0.9));
  }
  @media (prefers-reduced-motion: no-preference) {
    .circuit__pulses path {
      animation: pulse-run 6s var(--ease) infinite;
    }
    .circuit__pulses path:nth-child(2n) { animation-delay: 1.4s; animation-duration: 7s; }
    .circuit__pulses path:nth-child(3n) { animation-delay: 2.6s; animation-duration: 8s; }
    .circuit__pulses path:nth-child(4n) { animation-delay: 3.8s; }
    .circuit__pulses path:nth-child(5n) { animation-delay: 5s; animation-duration: 9s; }
  }
  @keyframes pulse-run {
    0% { stroke-dashoffset: 60; opacity: 0; }
    10% { opacity: 1; }
    70% { opacity: 1; }
    100% { stroke-dashoffset: -1000; opacity: 0; }
  }
</style>
