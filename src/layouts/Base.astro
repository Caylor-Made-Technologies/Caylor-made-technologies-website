---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import site from '../data/site.json';

interface Props {
  title: string;
  description: string;
  /** Use the title exactly as given (home page). Otherwise " | Caylor Made Technologies" is added. */
  exactTitle?: boolean;
  noindex?: boolean;
  /** Absolute path of a page-specific share image in /public. */
  image?: string;
}
const { title, description, exactTitle = false, noindex = false, image = '/og-image.jpg' } = Astro.props;
const fullTitle = exactTitle ? title : `${title} | ${site.name}`;
const canonical = new URL(Astro.url.pathname, site.url).href;
const imageUrl = new URL(image, site.url).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': ['ProfessionalService', 'LocalBusiness'],
  '@id': `${site.url}/#business`,
  name: site.name,
  slogan: site.tagline,
  description: 'Websites and custom software for small and local businesses in Hereford and the Texas Panhandle.',
  url: `${site.url}/`,
  logo: `${site.url}/icon-512.png`,
  image: imageUrl,
  email: site.email,
  telephone: site.phoneE164,
  founder: { '@type': 'Person', name: site.owner },
  foundingDate: site.founded,
  priceRange: '$$',
  address: {
    '@type': 'PostalAddress',
    addressLocality: site.city,
    addressRegion: site.region,
    postalCode: site.postalCode,
    addressCountry: site.country,
  },
  geo: { '@type': 'GeoCoordinates', latitude: site.geo.latitude, longitude: site.geo.longitude },
  areaServed: site.serviceArea.map((name) => ({ '@type': name === 'Texas Panhandle' ? 'Place' : 'City', name })),
  knowsAbout: ['Web design', 'Website development', 'Custom business software', 'Business automation'],
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#0B0F14" />
    <meta name="color-scheme" content="dark" />

    <link rel="preload" href="/fonts/montserrat-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/inter-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin />

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Caylor Made Technologies: Advanced Engineering. Built Different." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to main content</a>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
