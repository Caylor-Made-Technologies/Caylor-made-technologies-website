# Copy to .env (for `npm run dev`) and/or .dev.vars (for `wrangler pages dev`).
# Never commit the real values. In production, set these in
# Cloudflare dashboard -> Workers & Pages -> your project -> Settings -> Variables and Secrets.

# Public (safe to expose; baked into the page at build time)
PUBLIC_TURNSTILE_SITE_KEY=

# Secret (server only; used by functions/api/contact.ts)
TURNSTILE_SECRET_KEY=
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
